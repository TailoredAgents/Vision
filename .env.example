# Public URL used for canonical links, sitemap, and social metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep true on every preview deployment. Set false only on the approved production domain.
NEXT_PUBLIC_PREVIEW_MODE=true

# PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vision

# Generate independent random values of at least 32 characters.
AUTH_SECRET=replace-with-at-least-32-random-characters
RATE_LIMIT_SECRET=replace-with-a-different-random-value

# First administrator. The password must contain at least 12 characters.
# After setup, remove ADMIN_BOOTSTRAP_PASSWORD and ADMIN_SETUP_TOKEN from the environment.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-unique-password
ADMIN_SETUP_TOKEN=replace-with-a-one-time-setup-token
